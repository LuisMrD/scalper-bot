# Valores apenas para ambiente LOCAL; nao usar credenciais reais aqui.
# Este arquivo serve de referencia. Spring Boot NAO importa .env automaticamente.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3307/trading_bot?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=trading
DB_PASSWORD=trading_local_only
TRADING_SYMBOLS=BTCUSDT,ETHUSDT
TRADING_ORDERS_ENABLED=false
# Obrigatorios apenas quando configurarmos de fato o modulo de risco.
# Sem valores padrao; deixar indefinidos na etapa 1.
# TRADING_CAPITAL_USDT=
# TRADING_RISK_PER_TRADE_PCT=
# TRADING_DAILY_STOP_PCT=
# TRADING_LEVERAGE=
# A integracao real da IA vira em outra etapa.
# OPENAI_API_KEY=

# Etapa 2 — market data; por padrao desligado para evitar chamadas automaticas.
MARKET_DATA_INTERVALS=1m,5m,15m
MARKET_DATA_WS_ENABLED=false
MARKET_DATA_BOOTSTRAP_ENABLED=false
MARKET_DATA_BOOTSTRAP_DAYS=7
MARKET_DATA_PAGE_LIMIT=1000
MARKET_DATA_MAX_PAGES=30
MARKET_DATA_RECONCILE_MINUTES=120
MARKET_DATA_WS_PATH=/market/stream
MARKET_DATA_WS_RECONNECT_MS=30000
